{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:js|css|json|png|jpg|jpeg|gif|svg|ico|xml|txt)).*)",
      "destination": "/index.html"
    }
  ]
}
